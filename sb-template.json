{
  "log": { "level": "error" },
  "inbounds": [
    {
      "tag": "vless-ws-in",
      "listen": "127.0.0.1",
      "listen_port": 8001,
      "sniff": true,
      "sniff_override_destination": true,
      "protocol": "vless",
      "udp": true,
      "users": [
        { "uuid": "YOUR-UUID-HERE", "flow": "xtls-rprx-vision" }
      ],
      "transport": {
        "type": "ws",
        "path": "/proxy-XXXXX",
        "headers": { "Host": "YOUR-CF-HOSTNAME" }
      }
    }
  ],
  "dns": {
    "servers": [
      { "tag": "doh", "address": "https://1.1.1.1/dns-query" }
    ]
  },
  "route": {
    "rules": [
      { "domain": ["geosite:google"], "outbound": "direct" }
    ],
    "final": "direct"
  },
  "outbounds": [
    { "tag": "direct", "type": "direct" },
    { "tag": "block", "type": "block" }
  ]
}